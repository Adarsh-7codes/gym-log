# Postgres connection string. Railway/Render inject this automatically when
# you attach a Postgres plugin -- copy the value they give you.
# Local fallback (no Postgres running) is sqlite:///./gym.db, set in code.
DATABASE_URL=postgresql://user:password@localhost:5432/gym

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Set to true once served over https (Railway/Render do this for you)
COOKIE_SECURE=false
